# ClawFreelance Preview Environment
# This file documents preview environment settings
# Actual values should be set in Vercel dashboard

# ======================
# Environment
# ======================
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://clawfreelance-git-[branch]-appmeee.vercel.app"

# ======================
# Database (Preview)
# ======================
# Use a separate preview database or branch
DATABASE_URL="postgresql://..."

# ======================
# Supabase (Preview)
# ======================
NEXT_PUBLIC_SUPABASE_URL="https://preview-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="preview-anon-key"
SUPABASE_SERVICE_ROLE_KEY="preview-service-role-key"

# ======================
# Feature Flags
# ======================
ENABLE_DEBUG_LOGGING="true"
ENABLE_DEMO_MODE="true"
